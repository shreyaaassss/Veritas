<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.veritas.technologies.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/veritas-agent/venv/bin/python</string>
        <string>/opt/veritas-agent/agent.py</string>
        <string>--config</string>
        <string>/etc/veritas-agent/agent-config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/veritas-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Start at boot and keep alive (restart on crash) -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/var/log/veritas-agent/agent.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/veritas-agent/agent-error.log</string>
</dict>
</plist>
