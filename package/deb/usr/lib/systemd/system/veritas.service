[Unit]
Description=Veritas DPDPA Compliance Platform
After=network.target
Documentation=https://github.com/shreyaaassss/Veritas

[Service]
Type=simple
User=veritas
Group=veritas
WorkingDirectory=/opt/veritas
ExecStart=/opt/veritas/veritas-runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Data and secrets
Environment="VERITAS_DATA_DIR=/var/lib/veritas"
# TMPDIR must be writable by the veritas user for PyInstaller bundle extraction
Environment="TMPDIR=/var/lib/veritas/tmp"
EnvironmentFile=-/etc/veritas/config.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=true
ReadWritePaths=/var/lib/veritas /var/log/veritas /var/lib/veritas/tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=veritas

[Install]
WantedBy=multi-user.target
