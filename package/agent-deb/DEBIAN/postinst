#!/bin/bash
set -e

# Create system user for the agent
if ! id veritas-agent &>/dev/null; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /opt/veritas-agent veritas-agent
fi

# Permissions
chown -R veritas-agent:veritas-agent /opt/veritas-agent /etc/veritas-agent
chmod 640 /etc/veritas-agent/config.yaml

# Enable systemd service (don't start — user must configure first)
systemctl daemon-reload
systemctl enable veritas-agent

echo ""
echo "Veritas Agent installed successfully!"
echo ""
echo "Next steps:"
echo "  1. Edit /etc/veritas-agent/config.yaml"
echo "     Set: server_url, org_id, registration_key"
echo "  2. sudo systemctl start veritas-agent"
echo "  3. Verify: veritas-agent status"
echo ""
echo "Get a registration key from your Veritas dashboard → Agents tab."
