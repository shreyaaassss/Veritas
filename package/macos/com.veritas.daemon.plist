<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.veritas.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/veritas/veritas-runtime</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>VERITAS_DATA_DIR</key>
        <string>/var/lib/veritas</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/opt/veritas</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/veritas/veritas.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/veritas/veritas-error.log</string>
    <key>UserName</key>
    <string>_veritas</string>
</dict>
</plist>
