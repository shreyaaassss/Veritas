# Veritas Server — Production Configuration Template
# ====================================================
# Copy to .env and fill in values before starting Veritas.
# Permissions: chmod 600 .env  (owner read/write only)
#
# DO NOT commit this file with real values to version control.

# ---- TLS ----
# VERITAS_TLS=auto          (default: generate self-signed cert on first run)
# VERITAS_TLS=true          (require HTTPS, exit if cert unavailable)
# VERITAS_TLS=false         (HTTP only — development only, never production)
VERITAS_TLS=auto

# Paths to custom TLS certificate and key (optional — auto-generated if omitted)
# VERITAS_TLS_CERT=/etc/veritas/certs/server.crt
# VERITAS_TLS_KEY=/etc/veritas/certs/server.key

# Additional Subject Alternative Names for self-signed cert (comma-separated)
# VERITAS_TLS_SANS=veritas.internal,192.168.1.50

# ---- Cookies ----
# VERITAS_SECURE_COOKIES=true    (default when TLS is active — HTTPS-only cookies)
# VERITAS_SECURE_COOKIES=false   (development only)
# (This is set automatically based on VERITAS_TLS — only override if needed)

# ---- JWT Authentication ----
# VERITAS_JWT_SECRET=<strong-random-secret>
# Leave unset to auto-generate on first start (persisted to data_root/secrets/jwt_secret.key)
# If set, it overrides the persisted secret — rotate by changing this value.
# Minimum 32 characters. Use: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- JWT Session Duration ----
# VERITAS_JWT_EXPIRE_MINUTES=60  (default: 60 minutes)

# ---- AI / LLM (optional) ----
# Leave unset to disable LLM investigation. Core compliance monitoring works without it.
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Data Directory ----
# Where Veritas stores databases, configs, certs, and secrets.
# Default: same directory as run_pipeline.py (development)
# Production: set to a persistent, backed-up location.
# VERITAS_DATA_DIR=/var/lib/veritas

# ---- Force LLM Fallback (development) ----
# FORCE_LLM_FALLBACK=1  — use deterministic templates instead of LLM (testing only)
